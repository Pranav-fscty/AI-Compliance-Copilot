# Optional. Precedence: config.yaml < presets/<RAG_PRESET>.yaml < RAG_<KEY> environment variables.
# RAG_PRESET=default            # default | minilm | nomic | small_llm
# RAG_OLLAMA_BASE_URL=http://localhost:11434
# RAG_TOP_K=8
# RAG_DEBUG_ENDPOINTS=false     # true exposes /debug/retrieve and /docs; keep false for black-box testing
# MLFLOW_TRACKING_URI=http://localhost:5000   # eval runs log here instead of ./mlruns
LOG_LEVEL=INFO
